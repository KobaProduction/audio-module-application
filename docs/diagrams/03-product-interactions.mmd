---
title: "Подробная карта сущностей и сценариев"
---
flowchart TB
  subgraph IN["Что поступает в колонку"]
    USER["Человек и голос"]
    BUTTON["Кнопки и регуляторы"]
    PANEL["Веб-интерфейс"]
    MUSIC["Музыка и подкасты"]
    HOME["Умный дом"]
  end
  subgraph DIALOG["Голосовое взаимодействие"]
    WAKE["Триггерная фраза"]
    SPEECH["Запрос пользователя"]
    HELPER["Ассистент"]
    ANSWER["Ответ ассистента"]
  end
  subgraph CONTROL["Единое управление"]
    ACTION["Действие"]
    STATE["Состояние колонки"]
    PREF["Настройки владельца"]
  end
  subgraph OUTPUT["Звук и визуальная реакция"]
    PLAY["Воспроизводимый звук"]
    SINK["Выбранный аудиовыход"]
    FEATURE["Признаки музыки"]
    COLORS["Цветомузыка"]
    EMOTION["Индикация и эмоции"]
  end
  USER -->|"произносит"| WAKE
  WAKE -->|"открывает"| SPEECH
  SPEECH -->|"обрабатывает"| HELPER
  HELPER -->|"возвращает"| ANSWER
  HELPER -->|"предлагает"| ACTION
  BUTTON -->|"запускают"| ACTION
  PANEL -->|"запрашивает"| ACTION
  HOME <-->|"разрешённые действия"| ACTION
  PREF -->|"определяют"| ACTION
  ACTION -->|"меняет"| STATE
  STATE -->|"определяет"| SINK
  STATE -->|"показывается через"| EMOTION
  ANSWER -->|"озвучивается"| PLAY
  MUSIC -->|"становится"| PLAY
  PLAY -->|"поступает на"| SINK
  PLAY -->|"даёт музыкальные признаки"| FEATURE
  FEATURE -->|"управляют"| COLORS
