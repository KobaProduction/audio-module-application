---
title: "Общая карта сущностей умной колонки"
---
flowchart TB
  PERSON["Человек"] -->|"использует и настраивает"| DEVICE["Умная колонка"]
  DEVICE -->|"принимает"| VOICE["Голосовое обращение"]
  DEVICE -->|"получает"| INPUT["Кнопки и регуляторы"]
  DEVICE -->|"воспроизводит"| AUDIO["Звук"]
  DEVICE -->|"показывает"| FEEDBACK["Свет и индикация"]
  DEVICE -->|"подключает"| SERVICE["Внешние сервисы"]
  DEVICE -->|"имеет"| ABILITIES["Доступные возможности"]
  DEVICE -->|"сохраняет"| SETTINGS["Настройки владельца"]
  VOICE -->|"содержит"| INTENT["Намерение"]
  INTENT -->|"превращается в"| ACTION["Действие"]
  INPUT -->|"вызывает"| ACTION
  SERVICE -->|"может предложить"| ACTION
  SETTINGS -->|"определяют поведение"| ACTION
  ACTION -->|"изменяет"| STATE["Состояние колонки"]
  STATE -->|"влияет на"| AUDIO
  STATE -->|"отображается через"| FEEDBACK
  AUDIO -->|"может сопровождаться"| FEEDBACK
